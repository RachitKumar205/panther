#!/usr/bin/env bash
# Panther's one command. On your machine it syncs the code to the server and runs the same command there.
#
#   ./panther run 14b@5 [qat[=N]]  a contest (model size @ RAM budget in GiB), detached: fetch -> run -> publish;
#                                qat: a QAT finalist too (Block-AP on N samples of 2,048 tokens, default 4,096)
#   ./panther stop 14b@5         stop that run; started again, it continues where it stopped
#   ./panther pause | resume     pause / resume every Panther container (the dashboard keeps running)
#   ./panther status             containers, active runs and their claims, GPU, disk, the last log lines
#   ./panther build | test       build the server image | the tests (here, then on the server in the GPU image)
#   ./panther exec | cexec CMD   one command in a GPU | CPU (network) container (log: data/logs/[c]exec-<pid>.log)
#   ./panther dashboard          (re)start the read-only web dashboard
#
# A run claims its GPU and RAM when it starts and refuses to start if they do not fit beside the active runs.
# Settings: deploy/server/local.env (git-ignored).
set -uo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
. "$ROOT/deploy/server/local.env"
W="${PANTHER_WORK:-/s3/panther/work}"
usage() { sed -n 2,14p "$0"; }

if [ ! -d "$W" ]; then  # your machine: sync the code, then the same command on the server
  case "${1:-}" in ""|help) usage; exit 0 ;; test) (cd "$ROOT" && uv run pytest -q) || exit 1 ;; esac
  SSH="ssh -o ControlPath=$PANTHER_SSH_CONTROL -o ProxyCommand=false -o BatchMode=yes"
  $SSH "$PANTHER_HOST" true || { echo "No connection to the server; open it first (deploy/server/README.md)."; exit 1; }
  rsync -a --delete -e "$SSH" --exclude .git/ --exclude .venv/ --exclude /data/ --exclude __pycache__/ \
    --exclude .pytest_cache/ --exclude .claude/ "$ROOT/" "$PANTHER_HOST:$W/repo/" || exit 1
  exec $SSH "$PANTHER_HOST" "$W/repo/panther $(printf '%q ' "$@")"
fi

DATA="$W/data"; LOG="$DATA/logs/panther.log"; IMAGE=localhost/panther; CPUS="${PANTHER_CPUS:-40}"; LK="${LK:-}"
P=(podman --root "$W/containers/storage" --runroot "/run/user/$(id -u)/panther" --events-backend file --tmpdir "$W/tmp/libpod")
BOX=(--userns keep-id --cap-drop all --security-opt no-new-privileges --read-only -v "$W/repo:/work/repo:ro,z"
     --log-driver k8s-file)  # every container: no privileges, read-only, the code mounted read-only
PY=(/opt/venv/bin/python -m panther.run)
mkdir -p "$DATA/logs" "$DATA/locks" "$W/tmp/libpod"; export TMPDIR="$W/tmp"
log() { echo "$(TZ=Asia/Kolkata date +%H:%M) $*" >> "$LOG"; echo "$*"; }
healthy() { [ "$(curl -sL -o /dev/null -w '%{http_code}' --max-time 20 "$PANTHER_HEALTH_URL")" = 200 ]; }
held() { [ -e "$DATA/PAUSED" ] || [ -e "$DATA/PAUSED.guard" ] || ! healthy; }
ours() { "${P[@]}" ps --format '{{.Names}}' --filter "status=$1" | grep '^panther-' | grep -v '^panther-dashboard$'; }
pm() { if [ -n "$LK" ]; then "${P[@]}" "$@" {LK}>&-; else "${P[@]}" "$@"; fi; }  # podman never holds a run's lock
detach() { local f="$DATA/logs/$1.log"; shift; (setsid nohup "$0" "$@" >>"$f" 2>&1 < /dev/null &); }  # returns at once
parse() {  # 14b@5 -> size 14b, b 5, id 14b-b5
  [[ "${1:-}" =~ ^([0-9.]+[bB])@([0-9]+)$ ]] || { echo "write a run like 14b@5, not '${1:-}'"; exit 1; }
  size="${BASH_REMATCH[1],,}"; b="${BASH_REMATCH[2]}"; id="$size-b$b"
}
STEPS="fetch run publish"

args() {  # args cpu|gpu|none MEM: a container's options (no container has both GPU and network)
  a=("${BOX[@]}" --init --tmpfs /tmp:rw,size=16g --shm-size 2g --pids-limit 4096 --cpus "$CPUS" --memory "$2"
     --memory-swap "$2" -v "$DATA:/work/data:rw,z" -e "PANTHER_THREADS=$CPUS" -e "PANTHER_HF_REPO=$PANTHER_HF_REPO"
     -e "PANTHER_QAT=${PANTHER_QAT:-0}"
     --log-opt max-size=20mb)
  case "$1" in cpu) a+=(--network pasta) ;; none) a+=(--network none) ;;
    gpu) a+=(--device nvidia.com/gpu=all --security-opt label=disable --network none -e HF_HUB_OFFLINE=1) ;; esac
}

job() {  # job cpu|gpu NAME MEM CMD...: one container, waited for; its exit code. Log: data/logs/NAME.log
  local name="panther-$2" rc; args "$1" "$3"; shift 3
  if held; then echo "$name waits: paused, or GitLab unhealthy"; while held; do sleep 60; done; fi
  pm rm -f --ignore "$name" >/dev/null || return 1  # this run's own leftover (a stopped run), never another's
  pm run -d --name "$name" "${a[@]}" "$IMAGE:current" bash -o pipefail -c \
    '"$@" 2>&1 | tee -a "/work/data/logs/$0.log"' "${name#panther-}" "$@" >/dev/null || return 1
  rc="$(pm wait "$name" | head -1)"; pm rm "$name" >/dev/null; return "${rc:-1}"
}

start() {  # start SIZE@B [qat[=N]]: the claim now (or a loud refusal), then the three containers, detached
  local ram; parse "$1"
  case "${2:-}" in "") PANTHER_QAT=0 ;; qat) PANTHER_QAT=4096 ;; qat=[1-9]*) PANTHER_QAT="${2#qat=}" ;;
    *) echo "write the option as qat or qat=N (Block-AP samples), not '$2'"; exit 1 ;; esac
  [[ "$PANTHER_QAT" =~ ^[0-9]+$ && $((PANTHER_QAT % 2)) = 0 ]] || { echo "qat=N: N must be an even number"; exit 1; }
  export PANTHER_QAT
  "${P[@]}" image exists "$IMAGE:current" || "$0" build || exit 1
  [ -n "$("${P[@]}" ps -q --filter name='^panther-dashboard$')" ] || dashboard || exit 1
  pgrep -f "panther _guard" >/dev/null || detach guard _guard
  exec {LK}>>"$DATA/locks/run-$id.lock"; export LK  # held for the whole run, by this command and then _run
  flock -w 5 "$LK" || { log "$id: refused: already running" >&2; exit 1; }
  args none 8g  # a refusal: on stderr and one "refused" line in the main log (the dashboard does not count it a failure)
  ram="$(pm run --rm "${a[@]}" "$IMAGE:current" "${PY[@]}" claim "$size" "$b" | tail -1)" ||
    { echo "$ram"; echo "$1 not started" >&2; exit 1; }
  detach "$id" _run "$size" "$b" "$ram"
  echo "started $1${2:+ ($2)}: ${STEPS// / -> }; logs: data/logs/$id-<step>.log"
}

_run() {  # _run SIZE B RAM: the three containers in order; a failed one stops the run, loudly
  local id="$1-b$2" s rc
  echo $$ > "$DATA/locks/run-$id.pid"
  log "$id: started"
  for s in $STEPS; do
    job "$([ "$s" = run ] && echo gpu || echo cpu)" "$id-$s" "$3" "${PY[@]}" "$s" "$1" "$2"; rc=$?
    [ "$rc" = 0 ] && continue
    [ "$rc" = 3 ] || log "$id: FAILED in $s: its container exited $rc (out of memory, or killed?); its log:" \
      "data/logs/$id-$s.log — fix and rerun ./panther run $1@$2 (finished steps are kept)"
    exit 1  # 3: the run logged its own FAILED line
  done
  log "$id: done"
}

dashboard() {  # the read-only web dashboard: kept running (pause and stop leave it), data mounted read-only,
  # published only at PANTHER_DASHBOARD_BIND (default loopback; the reverse proxy's network gateway for a public URL)
  healthy || { log "GitLab is not healthy; not starting the dashboard"; return 1; }
  "${P[@]}" rm -f --ignore panther-dashboard >/dev/null || return 1
  "${P[@]}" run -d --name panther-dashboard --restart on-failure "${BOX[@]}" --tmpfs /tmp:rw,size=64m -e "PANTHER_HF_REPO=$PANTHER_HF_REPO" \
    --pids-limit 256 --cpus 2 --memory 1g --memory-swap 1g --network pasta \
    -p "${PANTHER_DASHBOARD_BIND:-127.0.0.1}:43800:43800" -v "$DATA:/work/data:ro,z" --log-opt max-size=5mb \
    "$IMAGE:current" /opt/venv/bin/python scripts/server/dashboard.py --data /work/data --host 0.0.0.0 --port 43800 \
    >/dev/null && echo "dashboard: http://${PANTHER_DASHBOARD_BIND:-127.0.0.1}:43800 on the server${PANTHER_DASHBOARD_DOMAIN:+, https://$PANTHER_DASHBOARD_DOMAIN}"
}

guard() {  # pauses everything while GitLab is unhealthy (3 bad checks), resumes after 5 good ones
  local bad=0 good=0
  while sleep 60; do
    if healthy; then good=$((good + 1)); bad=0; else bad=$((bad + 1)); good=0; fi
    if [ "$bad" -ge 3 ] && [ ! -e "$DATA/PAUSED.guard" ]; then
      touch "$DATA/PAUSED.guard"; ours running | xargs -r "${P[@]}" pause >/dev/null; log "GitLab unhealthy: paused"
    elif [ "$good" -ge 5 ] && [ -e "$DATA/PAUSED.guard" ]; then
      rm -f "$DATA/PAUSED.guard"; [ -e "$DATA/PAUSED" ] || ours paused | xargs -r "${P[@]}" unpause >/dev/null
      log "GitLab healthy again: resumed"
    fi
  done
}

case "${1:-}" in
  run) start "${2:-}" "${3:-}" ;;
  _run) shift; _run "$@" ;;
  stop)  # only that run, by its exact names: its _run (checked by its command line) is frozen, so it starts nothing
    # and logs nothing, while its containers stop; then it ends, and with it the claim (held until they are gone)
    parse "${2:-}"; f="$DATA/locks/run-$id.pid"
    pid="$([ -f "$f" ] && cat "$f")"
    if [ -n "$pid" ] && [ -r "/proc/$pid/cmdline" ] && tr '\0' ' ' < "/proc/$pid/cmdline" | grep -q "_run $size $b "
    then kill -STOP "$pid"; else pid=""; fi
    for s in $STEPS; do
      ! "${P[@]}" container exists "panther-$id-$s" || "${P[@]}" stop -t 30 "panther-$id-$s" >/dev/null
    done
    [ -z "$pid" ] || { kill -TERM "$pid"; kill -CONT "$pid"; }
    log "$id: stopped by the user (finished steps are kept)" ;;
  pause) touch "$DATA/PAUSED"; ours running | xargs -r "${P[@]}" pause >/dev/null; log "paused by the user" ;;
  resume) rm -f "$DATA/PAUSED"; ours paused | xargs -r "${P[@]}" unpause >/dev/null; log "resumed by the user" ;;
  status)
    "${P[@]}" ps --format '{{.Names}}\t{{.Status}}' | grep '^panther-'
    for f in "$DATA"/locks/run-*.lock; do [ -e "$f" ] && ! flock -n "$f" true && echo "active: $(basename "$f" .lock)"; done
    [ -f "$DATA/locks/claims.json" ] && echo "claims (an ended run's is dropped at the next start):" && cat "$DATA/locks/claims.json"
    nvidia-smi --query-gpu=utilization.gpu,memory.used,memory.total --format=csv,noheader
    df -h "$DATA" | tail -1; tail -5 "$LOG" ;;
  build)
    tag="$({ cat "$W/repo/deploy/server/Containerfile" "$W/repo/pyproject.toml" "$W/repo/uv.lock"
             grep -A3 '^llama_cpp:' "$W/repo/configs/models.yaml"; } | sha256sum | cut -c1-12)"
    "${P[@]}" image exists "$IMAGE:$tag" || "${P[@]}" build --memory 64g -t "$IMAGE:$tag" \
      --build-arg "LLAMA_COMMIT=$(awk '/^llama_cpp:/{f=1} f&&/commit:/{print $2; exit}' "$W/repo/configs/models.yaml")" \
      --build-arg "JOBS=$CPUS" -f "$W/repo/deploy/server/Containerfile" "$W/repo" || exit 1
    "${P[@]}" tag "$IMAGE:$tag" "$IMAGE:current" ;;
  test) job gpu "test-$$" 16g bash -c 'PYTHONPATH=/work/repo/src:/work/data/tools/pylib /opt/venv/bin/python -m pytest -q -p no:cacheprovider tests' ;;
  exec) shift; job gpu "exec-$$" 64g "$@" ;;
  cexec) shift; job cpu "cexec-$$" 64g "$@" ;;
  dashboard) dashboard ;;
  _guard) guard ;;
  *) usage ;;
esac
