#!/usr/bin/env bash
# The one entry point, run on the Mac.
#
#   ./panther run 7        sync the code to the server, run the 7 GiB budget there (every model in parallel), and
#                          send each model's winner to the Pi as soon as it is ready (one Pi check at a time)
#   ./panther status 7     the latest progress lines and what every lane is doing
#   ./panther watch 7      follow the progress live (one plain line per step and every 25 runs)
#
# Needs the server's SSH control master (deploy/server/local.env) and key login to the Pi (PANTHER_PI).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=/dev/null
. "$ROOT/deploy/server/local.env"
PI="${PANTHER_PI:-jia@100.89.94.89}"
ssh_s() { ssh -o ControlPath="$PANTHER_SSH_CONTROL" -o BatchMode=yes "$PANTHER_HOST" "$@"; }
sizes() { grep -E "^  $1: " "$ROOT/configs/search.yaml" | sed -E 's/.*searched: \[([^]]*)\], reference: \[([^]]*)\].*/\2,\1/' | tr ',' '\n' | grep . |
          sed -E 's/.*Qwen2\.5-([0-9.]+B).*/\1/' | tr 'A-Z' 'a-z'; }
cmd="${1:?usage: ./panther run|status|watch BUDGET}"; B="${2:?budget in GiB}"
case "$cmd" in
  run)
    "$ROOT/deploy/server/push.sh" >/dev/null
    ssh_s "cd /s3/panther/work/repo && deploy/server/run-budget.sh $B"
    mkdir -p "$HOME/panther-logs"
    nohup bash -c "for s in $(sizes "$B" | tr '\n' ' '); do PANTHER_PI='$PI' '$ROOT/pi/relay.sh' $B \$s '$PI'; done" \
      > "$HOME/panther-logs/pi-budget-$B.log" 2>&1 &
    echo "Pi checks for budget $B: $HOME/panther-logs/pi-budget-$B.log" ;;
  status)
    ssh_s "cd /s3/panther/work/data/logs && grep -E 'STOPPED|FAILED' progress-b$B.log 2>/dev/null | tail -n 3 | sed 's/^/!! /'; tail -n 12 progress-b$B.log 2>/dev/null; echo; for f in chain-b$B-*.log chain-b$B.log; do [ -f \$f ] && printf '%-20s %s\n' \"\${f#chain-}\" \"\$(tail -n 1 \$f | cut -c1-110)\"; done; true"
    tail -n 3 "$HOME/panther-logs/pi-budget-$B.log" 2>/dev/null || true ;;
  watch)  # a step table per model, refreshed every minute; stops (does not retry) if the server is unreachable
    prev=""
    while :; do
      snap="$(ssh_s "cd /s3/panther/work/data/logs && for f in chain-b$B-*.log; do echo \"LANE \${f#chain-b$B-} \$(tail -n 1 \$f)\"; done; tail -n 300 progress-b$B.log")" ||
        { echo "server unreachable; re-run ./panther watch $B once the SSH session is back"; exit 1; }
      [ -n "${PANTHER_WATCH_ONCE:-}" ] || clear
      echo "Budget $B GiB   $(TZ=Asia/Kolkata date +%H:%M) IST   (refreshes every minute; Ctrl-C to stop)"
      echo
      printf "%-8s %-17s %-12s %s\n" "Model" "Step" "Progress" "Last update"
      echo "$snap" | awk -v B="$B" '
        BEGIN { split("store:quantized copies,err:offline error,refs:reference,sens:part costs,list:solution list,test:tests,pick:winner,bundle:Pi bundle", m, ",")
                for (i in m) { split(m[i], kv, ":"); name[kv[1]] = kv[2] } }
        /^LANE / { lane = $2; sub(/\.log$/, "", lane); line = $0; step = "?"
                   if (line ~ /chain .* done/) step = "done"
                   else if (line ~ /stopped|FAILED/) step = "STOPPED"
                   else if (match(line, /rw-[a-z]+/)) { st = substr(line, RSTART + 3, RLENGTH - 3); step = (st in name) ? name[st] : st }
                   lanes[++n] = lane; laneStep[lane] = step; next }
        { key = $2; prog[key] = ""
          if (match($0, /[0-9]+\/[0-9]+/)) prog[key] = substr($0, RSTART, RLENGTH)
          else if (match($0, /: [0-9]+ KL runs to do/)) { v = substr($0, RSTART + 2, RLENGTH - 2); split(v, w, " "); prog[key] = "0/" w[1] }
          if (match($0, /round [0-9]+/)) prog[key] = prog[key] " (" substr($0, RSTART, RLENGTH) ")"
          when[key] = $1 }
        END { for (i = 1; i <= n; i++) { l = lanes[i]; mdl = toupper(l); sub(/^REF-/, "", mdl)
                printf "%-8s %-17s %-12s %s\n", mdl, laneStep[l], prog[mdl], when[mdl] } }'
      echo
      echo "Copies to the Pi (server -> Mac, then Mac -> Pi):"
      prev="$(python3 - "$B" "$prev" <<'PY'
import json, glob, os, sys, time
B, prev = sys.argv[1], dict(x.split("=") for x in sys.argv[2].split() if "=" in x)
now, out = time.time(), []
for man in sorted(glob.glob(os.path.expanduser(f"~/panther-bundle/budget-{B}-*/manifest.json"))):
    d = os.path.dirname(man)
    for name, f in json.load(open(man))["files"].items():
        total, done = f["bytes"], os.path.join(d, name)
        part = glob.glob(os.path.join(d, f".{name}.*"))
        have = os.path.getsize(done) if os.path.exists(done) else (os.path.getsize(part[0]) if part else 0)
        line = f"  {os.path.basename(d):14} {have/1e9:5.2f} / {total/1e9:.2f} GB  {100*have/total:3.0f}%"
        if have >= total:
            line += "  on the Mac"
        elif name in prev:
            t0, s0 = map(float, prev[name].split(","))
            rate = (have - s0) / max(now - t0, 1)
            line += f"  {rate/1e6:.1f} MB/s" + (f", ~{(total-have)/rate/60:.0f} min left" if rate > 0 else "")
        print(line, file=sys.stderr)
        out.append(f"{name}={now},{have}")
print(" ".join(out))
PY
)"
      for f in "$HOME"/panther-logs/pi-*.log; do [ -f "$f" ] && printf '  %-14s %s\n' "$(basename "$f" .log)" "$(tail -n 1 "$f" | sed -E 's/.*no such object: "panther-rw-bundle[0-9]+-([0-9a-z.]+)".*/waiting for the \1 bundle/' | cut -c1-90)"; done
      echo
      echo "Latest:"
      echo "$snap" | grep -v '^LANE ' | tail -n 6
      [ -n "${PANTHER_WATCH_ONCE:-}" ] && exit 0
      sleep 60
    done ;;
  *) echo "usage: ./panther run|status|watch BUDGET" >&2; exit 2 ;;
esac
