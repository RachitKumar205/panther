# Copy to deploy/server/local.env (git-ignored) and fill in. Read by ./panther on your machine and on the server
# (./panther syncs it there). The names match the earlier setup's, so an existing local.env keeps working; its other
# variables (dashboard, Hugging Face repo) are ignored.
PANTHER_HOST=user@server.example             # SSH target
PANTHER_SSH_CONTROL=$HOME/.ssh/cm-panther    # SSH control-master socket (you open it: see deploy/README.md)
PANTHER_WORK=/s3/panther/work                # Panther's folder on the server (the default)
PANTHER_CPUS=40                              # CPUs per container (the server has 48 threads)
PANTHER_HEALTH_URL=https://gitlab.example/   # the service that must stay up: ./panther run refuses, and pauses, while it is not 200
PANTHER_RAM=100g                             # memory of the run container (the server has 124 GB; GitLab shares it)
HF_TOKEN=                                    # a Hugging Face token, if a model or dataset is gated (Mistral)
