# Copy to deploy/server/local.env (git-ignored) and fill in. Read by push.sh on your machine
# and by panther.sh, host-setup.sh and uninstall.sh on the server (push.sh copies it there).
PANTHER_HOST=user@server.example                 # SSH target for push.sh
PANTHER_SSH_CONTROL=$HOME/.ssh/cm-panther        # SSH control-master socket (opened by you)
PANTHER_USER=user                                # unprivileged account that runs Panther on the server
PANTHER_HEALTH_URL=https://service.example.com   # a co-located service that must stay healthy (HTTP 200)
PANTHER_HF_REPO=your-hf-user/panther-{size}-{budget}g   # private repo per model and budget; the Pi downloads from it
